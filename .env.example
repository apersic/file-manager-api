POSTGRES_DB=file_manager
POSTGRES_USER=file_manager_user
POSTGRES_PASSWORD=file_manager_password
POSTGRES_PORT=5432

DATASOURCE_URL=jdbc:postgresql://localhost:5432/file_manager
DATASOURCE_USERNAME=file_manager_user
DATASOURCE_PASSWORD=file_manager_password
SHOW_SQL=true
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173

# Hikari pool. minimum idle must stay at or below the maximum. Times are milliseconds.
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=2
HIKARI_CONNECTION_TIMEOUT=10000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
